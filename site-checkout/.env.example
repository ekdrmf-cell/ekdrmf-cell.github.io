# 실제 값은 .env에 넣고 .env는 절대 커밋하지 말 것(.gitignore에 이미 등록됨).
# Vercel에 배포할 때는 이 값들을 Vercel 프로젝트 설정의 Environment Variables에 등록.

# 포트원 콘솔 → 웹훅 설정에서 발급받는 시크릿(웹훅 서명 검증용)
PORTONE_WEBHOOK_SECRET=

# 포트원 콘솔 → API 시크릿 발급 메뉴(결제 단건 조회 REST API 호출용, 웹훅 시크릿과 다른 값)
PORTONE_API_SECRET=

# Gmail 계정 (기존 ekdrmf@gmail.com 재사용 — 새 계정 불필요)
GMAIL_USER=ekdrmf@gmail.com
# Google 계정 설정 → 보안 → 2단계 인증 → 앱 비밀번호에서 무료 발급 (일반 로그인 비밀번호 아님)
GMAIL_APP_PASSWORD=
