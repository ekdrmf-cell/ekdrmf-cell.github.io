      "shi_shen_meanings": [
        {
          "name": "상관",
          "meaning": "내가 만들어내는 기운 중에서도 좀 더 날카로운 쪽입니다. 재능과 말솜씨가 뛰어나고 발상이 자유롭지만, 정해진 규칙과는 부딪히기 쉽습니다."
        },
        {
          "name": "편인",
          "meaning": "나를 키워주는 기운 중에서도 남다른 쪽입니다. 특별한 재능이나 직관이 뛰어나지만, 독창적인 만큼 변덕스럽게 비칠 때도 있습니다."
        },
        {
          "name": "비견",
          "meaning": "나와 기운이 똑같은 존재로, 형제자매나 동료 같은 자리입니다. 힘을 합치면 든든하지만, 같은 걸 두고 겨루게 되면 만만치 않은 경쟁자가 되기도 합니다."
        },
        {
          "name": "식신",
          "meaning": "내가 스스로 만들어내는 기운으로, 표현력과 생활의 활력을 뜻합니다. 느긋하고 온화하게 자기만의 것을 빚어내는 창조력에 가깝습니다."
        },
        {
          "name": "정인",
          "meaning": "나를 키워주는 기운으로, 학문이나 문서와 관련된 운을 뜻합니다. 누군가에게 보호받는 듯한 안정감, 인정받고 명예를 얻는 것과 관련이 깊습니다."
        },
        {
          "name": "겁재",
          "meaning": "나와 비슷하지만 결이 살짝 다른 기운으로, 경쟁자에 가까운 자리입니다. 밀어붙이는 힘은 좋지만, 그만큼 손에 쥔 재물이 빠져나가기 쉽다고 봅니다."
        },
        {
          "name": "칠살(편관)",
          "meaning": "나를 강하게 누르는 기운으로, 부담과 긴장이 따르는 자리입니다. 힘들게 느껴질 수 있지만, 그만큼 도전정신과 밀어붙이는 추진력의 원천이 되기도 합니다."
        }
      ],
      "twelve_stage_meanings": [
        {
          "name": "임관",
          "meaning": "나라의 녹봉을 받기 시작하는 시기입니다(건록이라고도 부릅니다). 실력을 인정받아 스스로의 힘으로 성취를 이루는 기운입니다."
        },
        {
          "name": "제왕",
          "meaning": "인생에서 가장 왕성한 시기입니다. 강한 리더십과 주도권을 쥐지만, 정상에 선 만큼 외로움도 함께 따를 수 있습니다."
        },
        {
